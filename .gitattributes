# Immer LF – die Migrationen werden über ihre Prüfsumme wiedererkannt (CRLF bräche den Start).
* text=auto eol=lf
*.png binary
*.ico binary

# Drittanbieter-Bibliotheken und generierte Dateien
public/** linguist-vendored=true
Cargo.lock linguist-generated=true
pnpm-lock.yaml linguist-generated=true

# Styles, Build-, Paket- und Hilfsdateien (die App selbst ist Rust)
*.css linguist-vendored=true linguist-detectable=false
*.js linguist-vendored=true linguist-detectable=false
*.html linguist-vendored=true linguist-detectable=false
*.sh linguist-vendored=true linguist-detectable=false
*.sql linguist-vendored=true linguist-detectable=false
justfile linguist-vendored=true linguist-detectable=false
umbrel/** linguist-vendored=true linguist-detectable=false
scripts/** linguist-vendored=true linguist-detectable=false
